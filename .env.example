# Google Maps Platform key for Geocoding, Places, and Directions APIs.
# Create/restrict a key in Google Cloud and keep your real .env file private.
GOOGLE_MAPS_API_KEY=your_google_api_key_here
MAP_PROVIDER=google

# Optional runtime settings
ENABLE_OSM_LOOKUPS=true
ALLOW_MODEL_DOWNLOAD=true
RETENTION_DAYS=30
# COORDINATOR_DB_PATH=.data/incidents.sqlite3
